generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  password  String?
  createdAt DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  imageUrl     String?
  githubUrl    String?
  demoUrl      String?
  technologies String
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
